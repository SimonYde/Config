#!/usr/bin/env -S nu --no-config-file

const SERVICES = [
    waybar.service
    hyprland-autoname-workspaces.service
    tailscale-systray.service
    network-manager-applet.service
    awww.service
]

def main [] {
    let enabled = hyprctl getoption animations.enabled
    | parse "bool: {enabled}"
    | $in.0.enabled
    | into bool

    if $enabled {
        hyprctl eval "
            hl.config({
                general = {
                    gaps_in = 0,
                    gaps_out = 0,
                    border_size = 1,
                },
                animations = { enabled = false },
                decoration = {
                    rounding = 0,
                    shadow = { enabled = false },
                    blur = { enabled = false },
                },
            })
        "

        $SERVICES | each {|service|
            try { systemctl --user stop $service }
        }
    } else {
        hyprctl reload
        $SERVICES | each {|service|
            try { systemctl --user start $service }
        }
    }
}
