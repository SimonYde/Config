#!/usr/bin/env -S nu --no-config-file

use std/log

def aux-display [] {
    if ("AUX_DISPLAY" in $env) {
        return $env.AUX_DISPLAY
    } else {
        return ""
    }

}

def state-file [] {
    let state_dir = ($env.XDG_STATE_HOME? | default $"($env.HOME)/.local/state")
    $state_dir | path join "toggle-display.json"
}

def remember-display [] {
    let display = hyprctl monitors -j | from json | where name like (aux-display) | first
    if ($display | is-empty) {
        log warning "Could not remember laptop display: auxiliary monitor not found"
        return
    }

    let file = state-file
    let directory = $file | path dirname
    if not ($directory | path exists) {
        mkdir $directory
    }

    let state = {
        mode: $"($display.width)x($display.height)@($display.refreshRate)"
        position: $"($display.x)x($display.y)"
        scale: $display.scale
    }
    log debug $"Remembering laptop display: mode=($state.mode), position=($state.position), scale=($state.scale)"
    $state | to json | save --force $file
}

def display-on [] {
    let file = state-file
    if ($file | path exists) {
        let display = open $file
        log info $"Enabling auxiliary display with saved configuration from ($file)"
        log debug $"Restoring auxiliary display: mode=($display.mode), position=($display.position), scale=($display.scale)"
        hyprctl eval $"
            hl.monitor\({
                output = '(aux-display)',
                mode = '($display.mode)',
                position = '($display.position)',
                scale = ($display.scale),
                disabled = false,
            }\)
        "
    } else {
        log info "Enabling auxiliary display with default configuration"
        hyprctl eval $"
            hl.monitor\({
                output = '(aux-display)',
                disabled = false,
            }\)
        "
    }
}

def display-off [] {
    remember-display
    log info "Disabling auxiliary display"
    hyprctl eval $"
        hl.monitor\({
            output = '(aux-display)',
            disabled = true,
        }\)
    "
}

def main [state?: string] {
    match $state {
        "on" => {
            display-on
        }

        "off" => {
            display-off
        }

        null => {
            let auxiliary = hyprctl monitors -j | from json | where name like (aux-display)

            if ($auxiliary | is-empty) {
                display-on
            } else {
                display-off
            }
        }
    }
}
