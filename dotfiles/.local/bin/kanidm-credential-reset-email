#!/usr/bin/env -S nu --no-config-file

def main [name: string, expiry?: int] {
    kanidm person get $name --output=json | from json | get attrs | let person

    let cred = kanidm person credential create-reset-token $person.name.0 ($expiry | default 86400)

    let token = $cred | lines | last 3 | first
    let expiry = $cred | lines | last | parse "{text}: {time}" | first | $"($in.text): ($in.time | format date)"
    [
        $"From: Kanidm <services@tmcs.dk>"
        $"To: ($person.mail.0)"
        $"Subject: Credentials reset for ($person.displayname.0)"
        "Hello,"
        ""
        "Below is a link that allows you to reset your login credentials for auth.simonyde.com."
        ""
        ($token)
        ($expiry)
        ""
        "NOTE: The maximum available expiry period for reset tokens is 24 hours."
        ""
        "Kind regards,"
        "Simon Yde Rasmussen."
    ]
    | str join (char newline)
    | sendmail ($person.mail.0)
    | print "Email sent successfully"

}
