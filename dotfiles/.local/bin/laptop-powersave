#!/usr/bin/env -S nu --no-config-file

use std/log

const USER_SERVICES = [
    hyprland-autoname-workspaces.service awww.service
]

const SERVICES = [
    bluetooth.service syncthing.service
]

def on [ ] {
    hyprctl eval "
        hl.config({
            general = {
                gaps_in = 0,
                gaps_out = 0,
                border_size = 1,
            },
            animations = { enabled = false },
            decoration = {
                rounding = 0,
                shadow = { enabled = false },
                blur = { enabled = false },
            },
        })
    "
    log info "Disabled power hungry hyprland decorations"

    powerprofilesctl set power-saver
    log info "Set power profile to `power-saver`"

    $USER_SERVICES | each {|service|
        try { systemctl --user stop $service }
    }
    log info "Stopped hungry user services"

    $SERVICES | each {|service|
        try { systemctl stop $service }
    }
    log info "Stopped hungry system services"
    set-refresh 60
    log info "Set screen refresh rate to 60"
}

def set-refresh [refresh: int] {
    let monitors = hyprctl monitors -j | from json
    $monitors | each {
        if $in.name like eDP {
            hyprctl eval $"
                hl.monitor\({
                    output = '($in.name)',
                    mode = '($in.width)x($in.height)@($refresh)',
                    position = '($in.x)x($in.y)',
                    scale = '($in.scale)',
                }\)
            "
        }
    }
}

def off [ ] {
    hyprctl reload
    powerprofilesctl set balanced
    log info "Set power profile to `balanced`"

    $USER_SERVICES | each {|service|
        try { systemctl --user start $service }
    }
    log info "Stopped hungry user services"

    $SERVICES | each {|service|
        try { systemctl start $service }
    }
    log info "Stopped hungry system services"
    set-refresh 120
    log info "Set screen refresh rate to 120"
}

def main [state?: string] {
    match $state {
        "on" => {
            on
        }

        "off" => {
            off
        }

        null => {
            on
        }
    }
}
